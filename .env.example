# ==============================================================================
# YouTube AI Assistant — Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env files containing real credentials to version control!
# In production, configure secrets directly in Cloudflare Workers using:
#   npx wrangler secret put <SECRET_NAME>
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI / Cloudflare Worker)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
API_VERSION=0.1.0
SERVICE_NAME=youtube-ai-api
ALLOWED_ORIGINS=chrome-extension://*,moz-extension://*,http://localhost:*,http://127.0.0.1:*

# Quotas & Rate Limits
DAILY_QUESTION_QUOTA=30
DAILY_TRANSCRIPT_QUOTA=20
MAX_CONCURRENT_STREAMS=1

# Cache TTL Settings (seconds)
CACHE_TTL_VIDEO_STATUS=60
CACHE_TTL_TRANSCRIPT=86400
CACHE_TTL_RETRIEVAL=3600

# Retention Policies
RETENTION_USAGE_EVENTS_DAYS=30
RETENTION_JOBS_DAYS=7
STALE_JOB_TIMEOUT_SECONDS=120

# Resilience & Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Authentication & Admin Keys (Development defaults; MUST be set via Cloudflare secret in prod)
# AUTH_TOKEN_SECRET must be at least 32 characters in production.
AUTH_TOKEN_SECRET=dev-insecure-secret-change-in-prod-32chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# ADMIN_API_KEY must be at least 16 characters in production.
ADMIN_API_KEY=yt-ai-admin-secret

# AI Providers (At least one required for live inference; set as Cloudflare secrets in prod)
# GEMINI_API_KEY=<set as Cloudflare secret>
# CF_ACCOUNT_ID=<your-cloudflare-account-id>
# CF_API_TOKEN=<your-cloudflare-api-token>

# ------------------------------------------------------------------------------
# Frontend Browser Extension Configuration (Vite / WXT)
# ------------------------------------------------------------------------------
# In development, the extension connects to the local pywrangler dev server.
# In production builds, set this to your deployed Cloudflare Worker domain:
# e.g., https://api.yourdomain.com or https://youtube-ai-api.<subdomain>.workers.dev
VITE_API_BASE_URL=http://localhost:8787
