{
  "name": "youtube-ai-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=youtube-ai-extension",
    "dev:backend": "npm run dev --workspace=youtube-ai-backend",
    "dev:firefox": "npm run dev:firefox --workspace=youtube-ai-extension",
    "build": "npm run build --workspace=youtube-ai-extension",
    "build:all": "npm run build --workspaces --if-present",
    "build:firefox": "npm run build:firefox --workspace=youtube-ai-extension",
    "test": "npm run test --workspaces --if-present",
    "test:extension": "npm run test --workspace=youtube-ai-extension",
    "typecheck": "npm run typecheck --workspace=youtube-ai-extension --workspace=@youtube-ai/shared-types",
    "typecheck:backend": "npm run typecheck:backend --workspace=youtube-ai-backend",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "postinstall": "npm run postinstall --workspace=youtube-ai-extension"
  },
  "overrides": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.6"
  }
}
